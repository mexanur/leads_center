generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String     // Hashed bcrypt password
  role          String     @default("recruiter") // "admin" | "recruiter"
  avatar        String?
  leads         Lead[]     @relation("AssignedLeads")
  notes         Note[]
  reminders     Reminder[]
  uploadedFiles LeadFile[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([role])
  @@map("users")
}

model Lead {
  id              String        @id @default(cuid())
  fullName        String
  phone           String
  email           String?
  source          String        @default("FACEBOOK") // FACEBOOK, INSTAGRAM, TELEGRAM, REFERRAL, INDEED, TIKTOK, DIRECT_CALL, OTHER
  sourceDetails   String?       // e.g. campaign name or referrer name
  status          String        @default("NEW_LEAD") // NEW_LEAD, CONTACTED, APPLICATION_SENT, DOCS_MVR_REVIEW, APPROVED_HIRED, REJECTED_ARCHIVED
  
  // Driver Qualifications
  cdlType         String        @default("CLASS_A") // CLASS_A, CLASS_B, CLASS_C, NON_CDL
  experienceYears Int           @default(0)
  endorsements    String?       // JSON string of array e.g. '["HazMat","Tanker"]'
  driverType      String?       // OTR, Regional, Local, Owner-Operator, Lease Purchase
  locationState   String?       // e.g. "TX", "OH", "IL"
  desiredPay      String?       // e.g. "$0.70 CPM" or "$2,000/week"
  notesText       String?       // quick bio or primary summary
  
  assignedToId    String?
  assignedTo      User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  notes           Note[]
  reminders       Reminder[]
  files           LeadFile[]
  activityLogs    ActivityLog[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([source])
  @@index([phone])
  @@index([email])
  @@index([cdlType])
  @@index([assignedToId])
  @@index([updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([assignedToId, status])
  @@map("leads")
}

model LeadFile {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name       String   // e.g. "John_CDL_Front.jpg"
  fileUrl    String   // Supabase Storage public URL
  filePath   String   // Storage bucket path
  fileType   String   @default("OTHER") // CDL_FRONT, CDL_BACK, MED_CARD, MVR_REPORT, RESUME, OTHER
  fileSize   Int      // Size in bytes
  mimeType   String?  // e.g. "image/jpeg", "application/pdf"
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_files")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  tag       String?  // e.g. "Call Log", "Driver Requirement", "Follow-up", "Pay Negotiation"
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([leadId, createdAt(sort: Desc)])
  @@map("notes")
}

model Reminder {
  id             String   @id @default(cuid())
  title          String
  dueAt          DateTime
  advanceMinutes Int      @default(15) // alert 15 mins before dueAt
  isCompleted    Boolean  @default(false)
  isNotified     Boolean  @default(false)
  priority       String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leadId])
  @@index([isCompleted, dueAt])
  @@index([userId, isCompleted, dueAt])
  @@map("reminders")
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String   // "STATUS_CHANGE", "NOTE_ADDED", "REMINDER_CREATED", "REMINDER_COMPLETED", "LEAD_CREATED", "FILE_UPLOADED", "FILE_DELETED"
  details   String
  userName  String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([leadId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model TelegramIntegration {
  id          String   @id @default(cuid())
  chatId      String   @unique // Telegram Chat ID (positive for users, negative for groups/channels)
  title       String   // Chat title or User name
  type        String   // "private" | "group" | "supergroup" | "channel"
  username    String?  // @username or @channel_name if available
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  addedById   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("telegram_integrations")
}

model TelegramPairingCode {
  id        String   @id @default(cuid())
  code      String   @unique // 6-digit OTC code e.g. "LC-8492"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([code])
  @@map("telegram_pairing_codes")
}

